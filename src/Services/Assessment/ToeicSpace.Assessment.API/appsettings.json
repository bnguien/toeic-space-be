{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "Jwt": {
    "Issuer": "toeicspace-identity",
    "Audience": "toeicspace-api",
    "PublicKey": ""
  },
  "ContentCache": {
    "ExpirationMinutes": 10
  },
  "Outbox": {
    "PollingIntervalSeconds": 5,
    "BatchSize": 50,
    "MaxAttempts": 10
  },
  "ForwardedHeaders": {
    "KnownNetworks": []
  }
}
