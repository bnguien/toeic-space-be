{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Otp": {
    "ChallengeTtlMinutes": 5,
    "ResendCooldownSeconds": 60,
    "HmacSecret": ""
  },
  "Identity": {
    "InactiveAccountRetentionDays": 3
  },
  "RabbitMQ": {
    "Host": "localhost",
    "VirtualHost": "/",
    "Username": "guest",
    "Password": "guest"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Jwt": {
    "Issuer": "toeicspace-identity",
    "Audience": "toeicspace-api",
    "PrivateKey": "",
    "AccessTokenLifetime": "00:10:00"
  },
  "Session": {
    "RefreshTokenLifetime": "7.00:00:00",
    "IdleTimeout": "1.00:00:00",
    "MaxActiveSessions": 5
  },
  "LoginLockout": {
    "MaxFailedAttempts": 5,
    "LockoutDuration": "00:15:00"
  },
  "RefreshCookie": {
    "Name": "__Secure-ts_rt",
    "Path": "/identity/api/auth"
  },
  "ForwardedHeaders": {
    "KnownNetworks": []
  }
}
