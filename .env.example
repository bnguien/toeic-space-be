# ASP.NET
ASPNETCORE_ENVIRONMENT=Development

# API Gateway
API_GATEWAY_PORT=5050

# RabbitMQ
RABBITMQ_HOST=messagebroker
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=your_rabbitmq_password

#Redis
REDIS_PORT=6379

# R2
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY=...
R2_SECRET_KEY=...
R2_BUCKET_NAME=toeic-space-media


# ==================================================
# IDENTITY DATABASE
# ==================================================

# Identity API
IDENTITY_API_PORT=6001

# Identity Database
IDENTITY_DB_ROOT_PASSWORD=your_root_password

IDENTITY_DB_HOST=identity-db
IDENTITY_DB_PORT=3306
IDENTITY_DB_NAME=toeic_space_identity
IDENTITY_DB_USER=identity_user
IDENTITY_DB_PASSWORD=your_database_password