# ASP.NET
ASPNETCORE_ENVIRONMENT=Development

# API Gateway
API_GATEWAY_PORT=5050

# RabbitMQ
RABBITMQ_HOST=messagebroker
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=your_rabbitmq_password

#Redis
REDIS_PORT=6379

# Identity OTP HMAC key (at least 32 random characters)
IDENTITY_OTP_HMAC_SECRET=replace-with-a-random-secret-of-at-least-32-characters
IDENTITY_INACTIVE_ACCOUNT_RETENTION_DAYS=3

# JWT (ES256). Generate the pair with: dotnet run scripts/GenerateJwtKeys.cs
# Only the Identity service receives the private key; other services get the public key.
JWT_ISSUER=toeicspace-identity
JWT_AUDIENCE=toeicspace-api
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Networks whose X-Forwarded-For header is trusted (the gateway / reverse proxy)
TRUSTED_PROXY_NETWORK=172.16.0.0/12

# First administrator, created once at startup. Remove the password after the first run.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# R2
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY=...
R2_SECRET_KEY=...
R2_BUCKET_NAME=toeic-space-media

# SMTP
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_SENDER_NAME=ToeicSpace
SMTP_SENDER_EMAIL=your-email@example.com
SMTP_PASSWORD="your-password"
SMTP_SUPPORT_EMAIL=support@toeicspace.com

# ==================================================
# IDENTITY DATABASE
# ==================================================

# Identity API
IDENTITY_API_PORT=6001

# Identity Database
IDENTITY_DB_ROOT_PASSWORD=your_root_password

IDENTITY_DB_HOST=identity-db
IDENTITY_DB_PORT=3306
IDENTITY_DB_NAME=toeic_space_identity
IDENTITY_DB_USER=identity_user
IDENTITY_DB_PASSWORD=your_database_password

# ==================================================
# ASSESSMENT DATABASE
# ==================================================

# Assessment API
ASSESSMENT_API_PORT=6004

# Assessment Database
ASSESSMENT_DB_ROOT_PASSWORD=your_root_password

ASSESSMENT_DB_HOST=assessment-db
ASSESSMENT_DB_PORT=3307
ASSESSMENT_DB_NAME=toeic_space_assessment
ASSESSMENT_DB_USER=assessment_user
ASSESSMENT_DB_PASSWORD=your_database_password
